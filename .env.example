# --- Backend selection ---
# elasticsearch | kubectl | k8s-api-dev | k8s-api-test
LOG_BACKEND=k8s-api-test

# --- 生产环境（Elasticsearch）---
# Kibana 内部 API 地址
KIBANA_URL=http://your-kibana-host:5601/internal/search/es

# 默认 ES 索引名称（namespace 参数可覆盖）
KIBANA_INDEX=platform-business

# --- kubectl backend（可选）---
# K8S_NAMESPACE=default
# K8S_LABEL_SELECTOR=app=rag-client
# K8S_CONTEXT=

# --- 开发环境（K8s API）---
# K8s API Server 地址
DEV_K8S_API_URL=https://192.168.1.91:6443

# ServiceAccount Token（只读权限）
DEV_K8S_API_TOKEN=

# --- 测试环境（K8s API）---
# K8s API Server 地址
TEST_K8S_API_URL=https://10.78.10.138:5443

# ServiceAccount Token（只读权限）
TEST_K8S_API_TOKEN=

# --- 共享配置 ---
# 跳过 TLS 证书验证（默认 true）
K8S_API_SKIP_TLS=true

# 默认容器名称（留空则自动取当前项目目录名）
# DEFAULT_CONTAINER=rag-client
